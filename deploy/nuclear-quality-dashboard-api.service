[Unit]
Description=Nuclear Quality Dashboard API and LAN snapshot receiver
After=network.target

[Service]
Type=simple
User=nuclear-dashboard
Group=nuclear-dashboard
WorkingDirectory=/srv/nuclear-quality-dashboard/app
EnvironmentFile=/etc/nuclear-quality-dashboard.env
ExecStart=/srv/nuclear-quality-dashboard/venv/bin/uvicorn dashboard_api.main:app --host 0.0.0.0 --port 8787
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
